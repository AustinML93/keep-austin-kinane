# Copy to .env beside docker-compose.yml. NEVER commit the real one (.gitignored).
# docker compose reads .env from this directory automatically.

# Ticketmaster Discovery — the CONSUMER KEY from developer.ticketmaster.com,
# not the Consumer Secret. Without it the source simply doesn't register.
TICKETMASTER_API_KEY=

# YouTube Data API v3 key from console.cloud.google.com.
# Optional: without it the playlist still syncs by scraping, but oEmbed reports
# a fixed 200x113 with no duration, so we can't tell a Short from a clip or
# detect vertical video.
YOUTUBE_API_KEY=

# The "Bits" playlist. Sync is the fast capture path — save a clip on YouTube in
# the moment, the app notices within 6h.
KAK_BITS_PLAYLIST=PLtOZF8lToGahb7E7f8xhyXurPYt_kcJkn
